rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Immutable individual round scores:
    // Students can create their scores with nickname and score value,
    // but CANNOT edit or delete existing score records.
    match /scores/{scoreId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['nickname', 'score', 'timestamp'])
                    && request.resource.data.score is number
                    && request.resource.data.nickname is string
                    && request.resource.data.nickname.size() > 0
                    && request.resource.data.nickname.size() <= 60;
      allow update, delete: if false;
    }

    // 2. Student classroom profile & multi-year stats:
    // Anyone can view leaderboard entries.
    // Students can create their profile or update their stats/streak upon round completion.
    match /students/{studentId} {
      allow read: if true;
      allow create: if request.resource.data.name is string
                    && request.resource.data.name.size() > 0;
      allow update: if request.resource.data.name is string
                    && request.resource.data.stats.totalScore is number;
      allow delete: if false;
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
